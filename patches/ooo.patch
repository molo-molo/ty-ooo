+    ///
+    /// This implements `allow-out-of-order-references`: a load that resolved to nothing in the
+    /// state that reaches it is retried as a deferred load, which ignores where in the scope the
+    /// load occurs. For example, `total` can use `base` even though `base` is only bound below.
+    ///
+    /// ```python
+    /// total = base + 1
+    /// base = 1
+    /// ```
+    ///
+    /// Returns `None` unless a deferred load finds a binding, so a name that is never bound stays
+    /// undefined and is still reported. Loads that are already deferred resolve against everything
+    /// reachable in the first place, so they need no retry.
+    ///
+    /// `place_expr` is only ever a symbol: the receiver of a member load was already resolved, and
+    /// attribute lookup does not depend on the ordering of a scope.
+    fn infer_out_of_order_place_load(
+        &self,
+        place_expr: PlaceExpr,
+    ) -> Option<PlaceAndQualifiers<'db>> {
+        if !self.settings().allow_out_of_order_references || self.is_deferred() {
+            return None;
